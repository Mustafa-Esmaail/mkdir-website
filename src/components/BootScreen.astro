---
/**
 * First-visit intro: the mkdir logo draws itself while a dashed
 * terminal-style progress bar fills up. Plays on every full load of the
 * home page (first open or refresh, EN and AR), never on other pages or on
 * client-side navigation. Skipped for visitors who prefer reduced motion.
 */
const DASHES = 28;
---
<div id="boot-screen" transition:persist="boot-screen" aria-hidden="true">
  <div class="bs-inner">
    <svg class="bs-logo" viewBox="14 12 96 96" width="128" height="128">
      <g fill="none" stroke-width="10" stroke-linecap="butt" stroke-linejoin="miter">
        <path class="bs-d bs-1" pathLength="1" d="M25 60V25H50L58 33H74" stroke="#F8FAFC" />
        <path class="bs-d bs-2" pathLength="1" d="M92 51V95H52" stroke="#F8FAFC" />
        <path class="bs-d bs-3" pathLength="1" d="M80 33H104" stroke="#2563EB" />
        <path class="bs-d bs-4" pathLength="1" d="M92 21V45" stroke="#2563EB" />
        <path class="bs-d bs-5" pathLength="1" d="M22 70L33 81L22 92" stroke="#2563EB" />
        <path class="bs-d bs-6" pathLength="1" d="M36 95H46" stroke="#2563EB" />
      </g>
    </svg>

    <div class="bs-word" dir="ltr">mkdir<span>/ solutions</span></div>

    <div class="bs-progress" dir="ltr">
      <span class="bs-br">[</span><span id="bs-dashes">{Array.from({ length: DASHES }, () => <i>-</i>)}</span><span class="bs-br">]</span>
      <span id="bs-pct" class="bs-pct">0%</span>
    </div>
    <div id="bs-status" class="bs-status" dir="ltr">$ mkdir solutions</div>
  </div>
</div>

<script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
  // Play only on a real (full) load of the home page — first visit or refresh.
  // Client-side navigation between pages never replays it.
  (function () {
    var el = document.getElementById('boot-screen');
    if (window.__mkdirBootChecked) return;      // already decided on this page load
    window.__mkdirBootChecked = true;
    var path = location.pathname;
    var b = base.replace(/\/$/, '');
    if (b && path.indexOf(b) === 0) path = path.slice(b.length);
    var isHome = /^\/(ar\/?)?(index\.html)?$/.test(path || '/');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isHome && !reduce) {
      el.setAttribute('data-state', 'play');
      document.documentElement.style.overflow = 'hidden';
    } else {
      el.setAttribute('data-state', 'done');
    }
  })();
</script>

<style is:global>
  #boot-screen {
    position: fixed; inset: 0; z-index: 200;
    display: none; place-items: center;
    background: #0B1120; color: #E2E8F0;
  }
  #boot-screen[data-state="play"], #boot-screen[data-state="out"] { display: grid; }
  #boot-screen[data-state="out"] { opacity: 0; transition: opacity .45s ease; pointer-events: none; }
  #boot-screen[data-state="out"] .bs-inner { transform: scale(1.04); transition: transform .45s ease; }

  .bs-inner { display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 24px; }

  /* logo draws itself, stroke by stroke */
  .bs-d { stroke-dasharray: 1 2; stroke-dashoffset: 1; opacity: 0; }
  #boot-screen[data-state="play"] .bs-d,
  #boot-screen[data-state="out"] .bs-d { animation: bs-draw .42s cubic-bezier(.65,0,.35,1) forwards; }
  .bs-1 { animation-delay: .05s !important; }
  .bs-2 { animation-delay: .38s !important; }
  .bs-3 { animation-delay: .72s !important; animation-duration: .2s !important; }
  .bs-4 { animation-delay: .86s !important; animation-duration: .2s !important; }
  .bs-5 { animation-delay: 1.02s !important; animation-duration: .24s !important; }
  .bs-6 { animation-delay: 1.22s !important; animation-duration: .14s !important; }
  @keyframes bs-draw { from { opacity: 1; stroke-dashoffset: 1; } to { opacity: 1; stroke-dashoffset: 0; } }

  .bs-word {
    font: 600 30px/1 var(--font-display, system-ui); letter-spacing: -.02em; color: #F8FAFC;
    opacity: 0; transform: translateY(6px);
  }
  .bs-word span { margin-inline-start: 8px; font: 400 13px var(--font-mono, monospace); letter-spacing: 0; color: #94A3B8; }
  #boot-screen[data-state="play"] .bs-word,
  #boot-screen[data-state="out"] .bs-word { animation: bs-in .4s ease 1.1s forwards; }
  @keyframes bs-in { to { opacity: 1; transform: none; } }

  .bs-progress { display: flex; align-items: baseline; gap: 2px; font: 15px/1 var(--font-mono, monospace); color: #334155; }
  .bs-progress i { font-style: normal; transition: color .12s ease; }
  .bs-progress i.on { color: #60A5FA; }
  .bs-br { color: #64748B; }
  .bs-pct { margin-inline-start: 12px; min-width: 4ch; color: #94A3B8; }
  .bs-status { font: 12.5px var(--font-mono, monospace); color: #64748B; min-height: 1.2em; }
  .bs-status.ok { color: #4ADE80; }

  @media (max-width: 420px) {
    .bs-logo { width: 104px; height: 104px; }
    .bs-progress { font-size: 13px; }
  }
</style>

<script>
  const el = document.getElementById('boot-screen');
  if (el && el.getAttribute('data-state') === 'play') {
    const dashes = Array.from(document.querySelectorAll<HTMLElement>('#bs-dashes i'));
    const pct = document.getElementById('bs-pct');
    const status = document.getElementById('bs-status');
    const DURATION = 1600;
    const steps = [
      [0, '$ mkdir solutions'],
      [0.35, '→ creating workspace…'],
      [0.7, '→ loading projects…'],
    ] as const;
    const start = performance.now();
    // ease-out with tiny pauses so it feels like real work, not a timer
    const ease = (t: number) => 1 - Math.pow(1 - t, 1.3);

    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / DURATION);
      const p = ease(t);
      const filled = Math.round(p * dashes.length);
      dashes.forEach((d, i) => d.classList.toggle('on', i < filled));
      if (pct) pct.textContent = `${Math.round(p * 100)}%`;
      const label = [...steps].reverse().find(([at]) => t >= at);
      if (status && label && status.textContent !== label[1]) status.textContent = label[1];

      if (t < 1) return requestAnimationFrame(tick);
      if (status) { status.textContent = '✓ ready'; status.classList.add('ok'); }
      setTimeout(() => {
        el.setAttribute('data-state', 'out');
        document.documentElement.style.overflow = '';
        setTimeout(() => el.setAttribute('data-state', 'done'), 480);
      }, 300);
    };
    requestAnimationFrame(tick);
  }
</script>
